{
	"id": "setup-workspace-workflow",
	"title": "Setup Workspace",
	"description": "Composite GitHub Action for setting up a workspace.",
	"type": "workflow",
	"requires": [
		"language",
		"nodeVersion"
	],
	"packs": [
		{
			"id": "typescript-pnpm",
			"title": "TypeScript (pnpm)",
			"when": {
				"language": "typescript",
				"packageManager": "pnpm"
			},
			"files": [
				{
					"source": "typescript/.github/actions/setup/action.pnpm.yml",
					"target": ".github/actions/setup/action.yml"
				}
			]
		},
		{
			"id": "typescript-default",
			"title": "TypeScript (npm, yarn, or bun)",
			"when": {
				"language": "typescript",
				"packageManager": [
					"npm",
					"yarn",
					"bun"
				]
			},
			"files": [
				{
					"source": "typescript/.github/actions/setup/action.default.yml",
					"target": ".github/actions/setup/action.yml"
				}
			]
		}
	]
}
