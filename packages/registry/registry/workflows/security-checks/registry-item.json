{
	"id": "security-checks-workflow",
	"title": "Security Checks",
	"description": "GitHub Actions security pipeline with dependency review, workflow linting, CodeQL, and Semgrep.",
	"type": "workflow",
	"requires": [
		"language",
		"defaultBranch"
	],
	"files": [
		{
			"source": ".github/workflows/security.yml",
			"target": ".github/workflows/security.yml"
		}
	],
	"packs": [
		{
			"id": "typescript",
			"title": "TypeScript",
			"when": {
				"language": "typescript"
			},
			"files": [
				{
					"source": "typescript/.github/codeql/config.yml",
					"target": ".github/codeql/config.yml"
				}
			]
		}
	]
}
