{
	"id": "repository-settings-workflow",
	"title": "Repository Settings",
	"description": "GitOps workflow that configures branch/tag rulesets and applies repository merge/security settings.",
	"type": "workflow",
	"requires": [
		"defaultBranch"
	],
	"secrets": [
		"GH_ADMIN_TOKEN"
	],
	"beforeWrite": "filter-active-workflow-checks.before-write.ts",
	"files": [
		{
			"source": ".github/workflows/settings.yml",
			"target": ".github/workflows/settings.yml"
		},
		{
			"source": ".github/rulesets/protected-branches.json",
			"target": ".github/rulesets/protected-branches.json"
		},
		{
			"source": ".github/rulesets/release-tags.json",
			"target": ".github/rulesets/release-tags.json"
		}
	]
}
