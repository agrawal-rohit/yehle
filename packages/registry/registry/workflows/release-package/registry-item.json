{
	"id": "release-package-workflow",
	"title": "Release Package",
	"description": "Release Please automation that opens a Release PR on pushes to main and handles package publication.",
	"type": "workflow",
	"requires": [
		"language",
		"defaultBranch"
	],
	"dependsOn": [
		"setup-workspace-workflow"
	],
	"secrets": [
		"GH_ADMIN_TOKEN"
	],
	"beforeWrite": "initialize-release-please-manifest.before-write.ts",
	"packs": [
		{
			"id": "typescript",
			"title": "TypeScript",
			"when": {
				"language": "typescript"
			},
			"files": [
				{
					"source": "typescript/.github/workflows/release.yml",
					"target": ".github/workflows/release.yml"
				},
				{
					"source": "typescript/release-please-config.json",
					"target": "release-please-config.json"
				},
				{
					"source": "typescript/.release-please-manifest.json",
					"target": ".release-please-manifest.json"
				}
			]
		}
	]
}
