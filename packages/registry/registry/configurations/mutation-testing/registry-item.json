{
	"id": "mutation-testing-configuration",
	"title": "Mutation Testing",
	"description": "Mutation testing configuration for catching weak tests.",
	"type": "configuration",
	"requires": [
		"language",
		"packageManager"
	],
	"packs": [
		{
			"id": "typescript",
			"title": "TypeScript",
			"when": {
				"language": "typescript"
			},
			"dependencies": {
				"npm": {
					"dev": [
						"@stryker-mutator/core@^9",
						"@stryker-mutator/vitest-runner@^9",
						"@stryker-mutator/typescript-checker@^9"
					]
				}
			},
			"commands": {
				"npm": {
					"mutate": "stryker run"
				}
			},
			"files": [
				{
					"source": "typescript/stryker.config.mjs",
					"target": "stryker.config.mjs"
				}
			]
		}
	]
}
