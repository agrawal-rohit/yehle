{
	"id": "pre-commit-hooks-configuration",
	"title": "Pre-commit Hooks",
	"description": "Local hooks that run lint, format, and commit checks before changes land.",
	"type": "configuration",
	"variants": [
		{
			"id": "typescript",
			"title": "TypeScript",
			"description": "Husky, commitlint, and lint-staged hooks for TypeScript projects using Biome.",
			"when": {
				"language": "typescript"
			},
			"devDependencies": [
				"husky@^9",
				"lint-staged@^16",
				"@commitlint/cli@^20",
				"@commitlint/config-conventional@^20"
			],
			"files": [
				{
					"source": "typescript/.husky/commit-msg",
					"target": ".husky/commit-msg"
				},
				{
					"source": "typescript/.husky/pre-commit",
					"target": ".husky/pre-commit"
				},
				{
					"source": "typescript/commitlint.config.js",
					"target": "commitlint.config.js"
				},
				{
					"source": "typescript/lint-staged.config.js",
					"target": "lint-staged.config.js"
				}
			]
		}
	]
}