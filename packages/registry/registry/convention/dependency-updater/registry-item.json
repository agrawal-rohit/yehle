{
	"id": "dependency-updater",
	"title": "Dependency Updater",
	"description": "Automated dependency update configuration.",
	"type": "convention",
	"variants": [
		{
			"id": "typescript",
			"title": "TypeScript",
			"description": "Dependabot configuration for npm and GitHub Actions updates in TypeScript projects.",
			"when": {
				"language": "typescript"
			},
			"files": [
				{
					"source": "typescript/.github/dependabot.yml",
					"target": ".github/dependabot.yml"
				}
			]
		}
	]
}
