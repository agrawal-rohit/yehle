{
  "version": "0.2.1",
  "schemaVersion": 1,
  "contentBaseUrl": "https://raw.githubusercontent.com/agrawal-rohit/tuckshop/tuckshop@0.2.1/packages/registry",
  "conditions": {
    "language": {
      "label": "Language",
      "description": "Which language is this project written in?",
      "inference": "files",
      "values": [
        {
          "value": "typescript",
          "label": "TypeScript",
          "files": [
            "package.json",
            "tsconfig.json"
          ]
        }
      ]
    }
  },
  "items": {
    "auto-assign-pr": {
      "id": "auto-assign-pr",
      "title": "Auto-assign PR to repository owner",
      "description": "Workflow that auto-assigns pull requests to the repository owner. Useful for repositories with a single owner.",
      "type": "convention",
      "variants": [
        {
          "id": "github-actions",
          "title": "GitHub Actions",
          "description": "GitHub Actions workflow that runs on pull request events to automatically assign the pull request to the repository owner.",
          "files": [
            {
              "source": "registry/convention/auto-assign-pr/github-actions/.github/workflows/auto-assign-pr.yml",
              "target": ".github/workflows/auto-assign-pr.yml"
            }
          ]
        }
      ]
    },
    "build": {
      "id": "build",
      "title": "Build",
      "description": "Build workflow for package ecosystems.",
      "type": "convention",
      "variants": [
        {
          "id": "typescript",
          "title": "TypeScript",
          "description": "GitHub Actions CI workflow for TypeScript projects using pnpm (check, build, and test).",
          "files": [
            {
              "source": "registry/convention/build/typescript/.github/workflows/build.yml",
              "target": ".github/workflows/build.yml"
            }
          ],
          "when": {
            "language": "typescript"
          }
        }
      ]
    },
    "button": {
      "id": "button",
      "title": "Button",
      "description": "Accessible button primitive.",
      "type": "component",
      "variants": [
        {
          "id": "react",
          "title": "React",
          "description": "React/TypeScript button component.",
          "files": [
            {
              "source": "registry/component/button/react/button.tsx",
              "target": "src/components/ui/button.tsx"
            }
          ],
          "dependencies": [
            "react"
          ]
        }
      ]
    },
    "changelog": {
      "id": "changelog",
      "title": "Changelog",
      "description": "Changelog generation configuration.",
      "type": "convention",
      "variants": [
        {
          "id": "typescript",
          "title": "TypeScript",
          "description": "git-cliff configuration for conventional-commit changelogs in TypeScript projects.",
          "files": [
            {
              "source": "registry/convention/changelog/typescript/cliff.toml",
              "target": "cliff.toml"
            }
          ],
          "when": {
            "language": "typescript"
          }
        }
      ]
    },
    "dependency-updater": {
      "id": "dependency-updater",
      "title": "Dependency Updater",
      "description": "Automated dependency update configuration.",
      "type": "convention",
      "variants": [
        {
          "id": "typescript",
          "title": "TypeScript",
          "description": "Dependabot configuration for npm and GitHub Actions updates in TypeScript projects.",
          "files": [
            {
              "source": "registry/convention/dependency-updater/typescript/.github/dependabot.yml",
              "target": ".github/dependabot.yml"
            }
          ],
          "when": {
            "language": "typescript"
          }
        }
      ]
    },
    "mutation-testing": {
      "id": "mutation-testing",
      "title": "Mutation Testing",
      "description": "Mutation testing configuration for catching weak tests.",
      "type": "convention",
      "variants": [
        {
          "id": "typescript",
          "title": "TypeScript",
          "description": "Stryker mutation testing config for TypeScript projects.",
          "files": [
            {
              "source": "registry/convention/mutation-testing/typescript/stryker.config.mjs",
              "target": "stryker.config.mjs"
            }
          ],
          "when": {
            "language": "typescript"
          },
          "devDependencies": [
            "@stryker-mutator/core@^9",
            "@stryker-mutator/vitest-runner@^9",
            "@stryker-mutator/typescript-checker@^9"
          ]
        }
      ]
    },
    "pre-commit-hooks": {
      "id": "pre-commit-hooks",
      "title": "Pre-commit Hooks",
      "description": "Local hooks that run lint, format, and commit checks before changes land.",
      "type": "convention",
      "variants": [
        {
          "id": "typescript",
          "title": "TypeScript",
          "description": "Husky, commitlint, and lint-staged hooks for TypeScript projects using Biome.",
          "files": [
            {
              "source": "registry/convention/pre-commit-hooks/typescript/.husky/commit-msg",
              "target": ".husky/commit-msg"
            },
            {
              "source": "registry/convention/pre-commit-hooks/typescript/.husky/pre-commit",
              "target": ".husky/pre-commit"
            },
            {
              "source": "registry/convention/pre-commit-hooks/typescript/commitlint.config.js",
              "target": "commitlint.config.js"
            },
            {
              "source": "registry/convention/pre-commit-hooks/typescript/lint-staged.config.js",
              "target": "lint-staged.config.js"
            }
          ],
          "when": {
            "language": "typescript"
          },
          "devDependencies": [
            "husky@^9",
            "lint-staged@^16",
            "@commitlint/cli@^20",
            "@commitlint/config-conventional@^20"
          ]
        }
      ]
    }
  }
}
