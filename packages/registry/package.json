{
	"name": "@tuckshop/registry",
	"version": "0.2.1",
	"description": "An opinionated tuckshop registry with project tooling configurations and GitHub Actions workflows.",
	"license": "MIT",
	"private": true,
	"scripts": {
		"build": "pnpm --filter @tuckshop/core run build && tsx ./scripts/build-registry.ts .",
		"typecheck": "pnpm --filter @tuckshop/core run build && tsc -p tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@tuckshop/core": "workspace:*",
		"spdx-license-list": "^6.12.0"
	}
}
