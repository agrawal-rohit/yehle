{
	"id": "typescript-react-app",
	"title": "TypeScript React App",
	"description": "Opinionated scaffold for a TypeScript React application.",
	"type": "template",
	"projectSpec": "app",
	"targets": { "language": "typescript", "framework": "react" },
	"inputs": [
		{
			"name": "public",
			"type": "boolean",
			"prompt": "Should this app live in a public repo? (adds a license, changelog, and build/release workflow)",
			"default": true
		},
		{
			"name": "includeInstructions",
			"type": "boolean",
			"prompt": "Would you like to include appropriate agent instructions?",
			"default": false
		},
		{
			"name": "instructionsIdeFormat",
			"type": "select",
			"prompt": "Which IDE should the instructions be written for?",
			"when": "includeInstructions",
			"optionsFrom": "ideFormats"
		},
		{
			"name": "name",
			"type": "string",
			"prompt": "What is the project name?",
			"required": true
		},
		{
			"name": "authorName",
			"type": "string",
			"prompt": "What is the author's name?",
			"when": "public"
		},
		{
			"name": "authorGitUsername",
			"type": "string",
			"prompt": "Under which GitHub account will this repository live?",
			"when": "public"
		},
		{
			"name": "authorGitEmail",
			"type": "string",
			"prompt": "What is the author's email?",
			"when": "public"
		}
	],
	"registryDependencies": [
		"typescript-git-hooks",
		"dependency-updater",
		"typescript-app-convention",
		"build",
		"app-release",
		"code-of-conduct",
		"pull-request-template",
		"issue-templates",
		"auto-assign",
		{ "name": "principles", "when": "includeInstructions" },
		{ "name": "workflow", "when": "includeInstructions" },
		{ "name": "typescript", "when": "includeInstructions" },
		{ "name": "react", "when": "includeInstructions" },
		{
			"name": "setup-typescript-app-react",
			"when": "includeInstructions"
		},
		{
			"name": "documentation-maintainer",
			"when": "includeInstructions"
		}
	],
	"transforms": [
		{ "file": "biome.json", "op": "stripJsonKey", "key": "root", "when": "!public" }
	]
}
