{
  "name": "{{ name }}",
  "description": "A React UI scaffold for interactive demos, playgrounds, and SaaS-style interfaces",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "packageManager": "{{ packageManagerVersion }}",
  {{#public}}
  "license": "MIT",
  "homepage": "https://github.com/{{ authorGitUsername }}/{{ name }}#readme",
  "bugs": "https://github.com/{{ authorGitUsername }}/{{ name }}/issues",
  "repository": "https://github.com/{{ authorGitUsername }}/{{ name }}",
  "author": "{{ authorName }} <{{ authorGitEmail }}>",
  {{/public}}
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "cov": "vitest run --coverage --passWithNoTests",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec biome lint --write",
    "format": "pnpm exec biome format --write",
    "check": "pnpm run typecheck && pnpm exec biome check --write",
    "check:ci": "pnpm run typecheck && pnpm exec biome check"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-color": "^2.19.3",
    "lucide-react": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@tailwindcss/vite": "^4.1.17",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.3",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "3.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.2",
    "vite": "^7.2.7",
    "vitest": "^3.2.4",
    "happy-dom": "^20.0.11"{{#public}},
    "git-cliff": "^2.10.1"{{/public}}
  }
}
