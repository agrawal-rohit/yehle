{
	"id": "typescript-package-convention",
	"title": "TypeScript Package Convention",
	"description": "README, CONTRIBUTING, and gitignore defaults for TypeScript packages.",
	"type": "convention",
	"projectSpec": "package",
	"targets": { "language": "typescript" },
	"inputs": [
		{
			"name": "name",
			"type": "string",
			"prompt": "What is the project name?",
			"required": true
		},
		{
			"name": "authorName",
			"type": "string",
			"prompt": "What is the author's name?",
			"when": "public"
		},
		{
			"name": "authorGitUsername",
			"type": "string",
			"prompt": "Under which GitHub account will this repository live?",
			"when": "public"
		}
	],
	"files": [
		{ "path": ".gitignore", "target": ".gitignore" },
		{ "path": "README.mustache.md", "target": "README.md", "template": true },
		{
			"path": "CONTRIBUTING.mustache.md",
			"target": "CONTRIBUTING.md",
			"template": true,
			"visibility": "public"
		}
	]
}
