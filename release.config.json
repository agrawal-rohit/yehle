{
	"tagSeparator": "@",
	"baseBranch": "main",
	"bootstrapRef": "v0.2.1",
	"commitPathFallback": ["packages/**", ".github/**", "README.md", "CONTRIBUTING.md"],
	"releaseCommitMessage": "chore(release): {tags} [skip ci]",
	"packages": [
		{
			"id": "cli",
			"path": "packages/cli",
			"tagName": "tuckshop",
			"publish": true,
			"paths": ["packages/cli/**", "packages/registry/**"],
			"linkedBumps": ["registry"],
			"manifestFiles": ["package.json"],
			"bumpCommand": "npm version {version} --no-git-tag-version",
			"publishCommand": "pnpm publish --provenance --access public --no-git-checks",
			"preVersionHooks": ["pnpm run build:registry"],
			"stagePaths": ["packages/registry/registry.json"]
		},
		{
			"id": "core",
			"path": "packages/core",
			"tagName": "core",
			"publish": true,
			"paths": ["packages/core/**"],
			"manifestFiles": ["package.json"],
			"bumpCommand": "npm version {version} --no-git-tag-version",
			"publishCommand": "pnpm publish --provenance --access public --no-git-checks"
		},
		{
			"id": "registry",
			"path": "packages/registry",
			"publish": false,
			"paths": ["packages/registry/**"],
			"manifestFiles": ["package.json"],
			"bumpCommand": "npm version {version} --no-git-tag-version"
		}
	]
}
