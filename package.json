{
	"version": "0.0.1",
	"name": "tuckshop",
	"description": "An opinionated code registry for distributing project templates, components, themes, blocks, conventions, and other common recipes.",
	"bin": "./bin/cli.mjs",
	"files": [
		"dist",
		"bin",
		"registry.json",
		"README.md",
		"LICENSE"
	],
	"author": "Rohit Agrawal <https://github.com/agrawal-rohit>",
	"repository": "https://github.com/agrawal-rohit/tuckshop",
	"homepage": "https://github.com/agrawal-rohit/tuckshop#readme",
	"license": "MIT",
	"private": false,
	"engines": {
		"node": ">=20"
	},
	"bugs": "https://github.com/agrawal-rohit/tuckshop/issues",
	"scripts": {
		"test": "vitest",
		"test-mutations": "stryker run",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"lint": "pnpm exec biome lint --write",
		"format": "pnpm exec biome format --write",
		"check": "pnpm run typecheck && pnpm exec biome check --write",
		"check:ci": "pnpm run typecheck && pnpm -C docs typecheck && pnpm exec biome check",
		"cov": "vitest run --coverage --passWithNoTests",
		"prepack": "pnpm run build:registry && pnpm run build",
		"build:registry": "tsx scripts/build-registry.ts",
		"prepare": "husky",
		"docs:dev": "pnpm -C docs dev",
		"docs:build": "pnpm -C docs build",
		"docs:start": "pnpm -C docs start",
		"docs:mdx": "pnpm -C docs mdx",
		"docs:typecheck": "pnpm -C docs typecheck"
	},
	"dependencies": {
		"cac": "^6.7.14",
		"chalk": "^5.6.2",
		"consola": "^3.2.3",
		"gray-matter": "^4.0.3",
		"listr2": "^10.1.0",
		"mustache": "^4.2.0",
		"spdx-license-list": "^6.11.0",
		"validate-npm-package-name": "7.0.2",
		"yaml": "^2.8.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@commitlint/cli": "^21.1.0",
		"@commitlint/config-conventional": "^21.1.0",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/typescript-checker": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@types/jest": "^30.0.0",
		"@types/mustache": "^4.2.5",
		"@types/node": "^26.0.1",
		"@types/validate-npm-package-name": "^4.0.2",
		"@vitest/coverage-v8": "4.1.9",
		"git-cliff": "^2.13.1",
		"glob": ">=13.0.6",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"lint-staged": "^17.0.8",
		"typescript": "^5.9.3",
		"tsx": "^4.22.4",
		"vitest": "^4.1.9"
	},
	"packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
	"pnpm": {
		"overrides": {
			"ajv": ">=8.18.0"
		}
	}
}
