{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"files": {
		"includes": [
			"bin/**",
			"src/**/*.{js,ts,jsx,tsx,json,cjs,mjs,yaml,css}",
			"docs/**/*.{js,ts,jsx,tsx,mjs,json,css}",
			"!templates",
			"!docs/.next",
			"!docs/.source",
			"!docs/out",
			"!docs/build"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": { "recommended": true }
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	}
}
